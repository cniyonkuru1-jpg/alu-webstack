global
	log /dev/log	local0
	log /dev/log	local1 notice
daemon
	maxconn 2048

defaults
	log	global
	mode	http
	option	httplog
	option	dontlognull
	timeout connect 5000
	timeout client 50000
	timeout server 50000

frontend www-http
	mode http
	bind *:80
	redirect scheme https code 301 if !{ ssl_fc }

frontend www-https
	mode http
	bind *:443 ssl crt /etc/haproxy/certs/www.pem
	default_backend webservers

backend webservers
	mode http
	balance roundrobin
	option httpchk GET /
	server web-01 18.171.162.21:80 check
	server web-02 18.171.164.153:80 check